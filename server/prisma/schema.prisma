generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProjectType {
  WEBSITE
  MOBILE_APP
  DIGITAL_MARKETING
  SAAS
  CLOUD_DEVOPS
  CONSULTING
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  WAITING_FOR_CLIENT
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum PaymentStatus {
  ADVANCE
  PAID
  PARTIAL
  DUE
  OVERDUE
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCUSSION
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum EventType {
  MEETING
  FOLLOW_UP
  PAYMENT
  TASK
  DEADLINE
  OTHER
}

enum EventStatus {
  SCHEDULED
  DONE
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String   @default("Yogeshwaran")
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Client {
  id                   String      @id @default(cuid())
  name                 String
  company              String?
  phone                String?
  email                String?
  address              String?
  notes                String?
  isActive             Boolean     @default(true) @map("is_active")
  convertedFromLeadId  String?     @map("converted_from_lead_id")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  projects   Project[]
  followUps  FollowUp[]
  events     Event[]

  @@index([name])
  @@index([company])
  @@map("clients")
}

model Project {
  id                 String        @id @default(cuid())
  clientId           String        @map("client_id")
  name               String
  projectType        ProjectType   @default(WEBSITE) @map("project_type")
  status             ProjectStatus @default(PLANNING)
  priority           Priority      @default(MEDIUM)
  startDate          DateTime?     @map("start_date")
  expectedEndDate    DateTime?     @map("expected_end_date")
  totalValue         Decimal       @db.Decimal(12, 2) @map("total_value")
  assignedEmployeeId String?       @map("assigned_employee_id")
  notes              String?
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  client             Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  assignedEmployee   Employee?     @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  payments           Payment[]
  events             Event[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model Payment {
  id           String        @id @default(cuid())
  projectId    String        @map("project_id")
  label        String
  amount       Decimal       @db.Decimal(12, 2)
  dueDate      DateTime?     @map("due_date")
  receivedDate DateTime?     @map("received_date")
  status       PaymentStatus @default(DUE)
  method       String?
  notes        String?
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@index([receivedDate])
  @@map("payments")
}

model Lead {
  id                String       @id @default(cuid())
  name              String
  company           String?
  phone             String?
  email             String?
  source            String?
  interestedService ProjectType? @map("interested_service")
  estimatedValue    Decimal?     @db.Decimal(12, 2) @map("estimated_value")
  status            LeadStatus   @default(NEW)
  nextFollowUpAt    DateTime?    @map("next_follow_up_at")
  notes             String?
  convertedClientId String?      @map("converted_client_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  followUps         FollowUp[]

  @@index([status])
  @@map("leads")
}

model FollowUp {
  id        String   @id @default(cuid())
  clientId  String?  @map("client_id")
  leadId    String?  @map("lead_id")
  dueAt     DateTime @map("due_at")
  note      String
  status    String   @default("PENDING")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([leadId])
  @@index([dueAt])
  @@map("follow_ups")
}

model Event {
  id              String      @id @default(cuid())
  type            EventType   @default(MEETING)
  title           String
  notes           String?
  clientId        String?     @map("client_id")
  projectId       String?     @map("project_id")
  startAt         DateTime    @map("start_at")
  endAt           DateTime?   @map("end_at")
  allDay          Boolean     @default(false) @map("all_day")
  reminderMinutes Int?        @map("reminder_minutes")
  status          EventStatus @default(SCHEDULED)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([startAt])
  @@map("events")
}

model Employee {
  id         String    @id @default(cuid())
  name       String
  roleTitle  String    @map("role_title")
  phone      String?
  email      String?
  baseSalary Decimal   @db.Decimal(12, 2) @map("base_salary")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  projects   Project[]
  salaries   Salary[]
  expenses   Expense[]

  @@map("employees")
}

model Salary {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  month       String
  baseSalary  Decimal   @db.Decimal(12, 2) @map("base_salary")
  bonus       Decimal   @default(0) @db.Decimal(12, 2)
  deductions  Decimal   @default(0) @db.Decimal(12, 2)
  finalAmount Decimal   @db.Decimal(12, 2) @map("final_amount")
  status      String    @default("PENDING")
  paidOn      DateTime? @map("paid_on")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([employeeId, month])
  @@map("salaries")
}

model Expense {
  id            String    @id @default(cuid())
  date          DateTime
  category      String
  description   String
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    @map("payment_method")
  employeeId    String?   @map("employee_id")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  employee      Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([category])
  @@map("expenses")
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  summary    String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_log")
}

model BusinessSetting {
  id                      String   @id @default(cuid())
  businessName            String   @default("INFYNUXSOLUTIONS") @map("business_name")
  logoText                String   @default("INFYNUX") @map("logo_text")
  currency                String   @default("INR")
  financialYearStartMonth Int      @default(4) @map("financial_year_start_month")
  reminderDefaults        Int      @default(60) @map("reminder_defaults")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("business_settings")
}
